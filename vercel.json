{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/guess",
      "destination": "/guess.html"
    }
  ]
}
